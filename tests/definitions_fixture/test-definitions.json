  {
   "id": "ozone",
   "match": [
    "^(izotope )?ozone\\b"
   ],
   "vendor": "iZotope",
   "adapter": "izotope",
   "decoder": "izotope_json",
   "status": "validated",
   "validated": [
    {
     "live": "12.4",
     "date": "2026-10-09",
     "variant": "transfer",
     "result": "ok",
     "by": "maintainer",
     "note": "Ozone 9 (VST2 et VST3) → Ozone 10 VST3 : réglages repris (63/64 et 65/65 valeurs, vérifié par re-sauvegarde dans Live) à condition d'écrire aussi ControllerState."
    },
    {
     "live": "12.4",
     "date": "2026-10-09",
     "variant": "transfer",
     "result": "ko",
     "by": "maintainer",
     "note": "Ozone 8 (VST3) et Ozone 7 (VST2) → Ozone 10 : l'état est ignoré (Ozone 10 ré-enregistre ses réglages par défaut, 0 écart sur 1346 valeurs). Structure des réglages différente."
    }
   ],
   "notes": "Ozone 9 → 10 : l'état est repris si ControllerState contient aussi l'état. Ozone 8 et antérieurs : état ignoré par Ozone 10 ; la conversion installe alors Ozone 10 avec ses réglages par défaut et garde l'ancien nom de preset en note.",
   "copy_controller_state": true,
   "preferred_state_mode": "transfer",
   "state_transfer_from": [
    "^(izotope )?ozone 9\\b",
    "^(izotope )?ozone 10\\b"
   ]
  },
